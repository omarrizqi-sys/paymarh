# ---------------------------------------------------------------------------
# PaymaRH - Exemple de variables d'environnement
#
# Copiez ce fichier en ".env" a la racine du depot puis adaptez les valeurs :
#   cp .env.example .env        (Linux / macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Le fichier ".env" est ignore par Git : il ne doit JAMAIS contenir de secret
# reel qui serait pousse sur le depot.
# ---------------------------------------------------------------------------

# --- Base de donnees PostgreSQL (service "postgres" de docker-compose.yml) ---
POSTGRES_USER=paymarh
POSTGRES_PASSWORD=paymarh_local_dev
POSTGRES_DB=paymarh
POSTGRES_PORT=5432

# URL de connexion utilisee par Prisma. Elle doit refleter les 4 variables
# ci-dessus. "localhost" car la base tourne dans Docker mais est exposee sur
# le port de la machine hote.
DATABASE_URL="postgresql://paymarh:paymarh_local_dev@localhost:5432/paymarh?schema=public"

# --- API (NestJS) ---
API_PORT=3001
# Origines autorisees a appeler l'API (CORS), separees par des virgules.
API_CORS_ORIGINS=http://localhost:3000

# --- Back-office (Next.js) ---
# URL publique de l'API, lue par le navigateur. Le prefixe NEXT_PUBLIC_ est
# impose par Next.js pour exposer une variable cote client.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Authentification (Auth.js) ---
# COQUILLE DESACTIVEE au module 0 : ces variables sont declarees pour memoire,
# aucune authentification n'est branchee. Voir apps/back-office/src/lib/auth/.
# AUTH_SECRET=remplacer-par-un-secret-genere-aleatoirement
# AUTH_URL=http://localhost:3000

# --- Stockage d'objets (type S3) ---
# COQUILLE DESACTIVEE au module 0 : seule l'interface existe, aucune
# implementation concrete. Voir apps/api/src/deliverables/.
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_BUCKET=paymarh-livrables
# OBJECT_STORAGE_ACCESS_KEY=cle-d-acces-exemple
# OBJECT_STORAGE_SECRET_KEY=cle-secrete-exemple
