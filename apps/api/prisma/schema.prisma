// ---------------------------------------------------------------------------
// PaymaRH - Schema de donnees
//
// MODULE 0 : socle multi-tenant (Account, Company, User, AuditLog, roles).
// MODULE 1 (etape 1.1.a) : fiche societe, etablissements, comptes bancaires,
//   historisation par moisEffet, tables de reference nationales.
// MODULE 2 (etape 2.1.a) : fiche salarie — modele de donnees uniquement.
//
// AUCUN bulletin / cotisation / organisme social ici.
// AUCUN calcul de paie. Le moteur (payroll-engine/) reste vide.
//
// Hierarchie d isolation : Account -> Company -> Etablissement -> (Salarie).
// ---------------------------------------------------------------------------

// Depuis Prisma 7, le client est genere en TypeScript dans le projet (et non
// plus dans node_modules) et l URL de connexion vit dans prisma.config.ts.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enumerations — socle
// ---------------------------------------------------------------------------

/// Nature du titulaire de l abonnement.
enum AccountType {
  /// Cabinet : gere la paie de plusieurs societes clientes.
  CABINET
  /// Entreprise : gere la paie de ses propres salaries.
  ENTREPRISE
}

/// Roles utilisateurs. Doit rester aligne sur packages/shared-types/src/role.ts.
enum Role {
  /// Super-admin plateforme : HORS HIERARCHIE, accountId obligatoirement nul.
  PLATFORM_ADMIN
  /// Administrateur d un compte client.
  ACCOUNT_ADMIN
  /// Gestionnaire de paie.
  MANAGER
  /// Salarie : prevu pour le futur portail salarie, non utilise au module 0.
  EMPLOYEE
}

// ---------------------------------------------------------------------------
// Enumerations — fiche societe (module 1)
// ---------------------------------------------------------------------------

/// Regime CNSS de base de la societe.
/// Une seule valeur pour l instant ; AGRICOLE viendra plus tard.
/// Non historise : modification bloquee des qu un salarie existe (etape ulterieure).
enum RegimeDeBase {
  NON_AGRICOLE
}

/// Periodicite de production de la paie.
/// Une seule valeur pour l instant ; d autres periodicites viendront plus tard.
enum PeriodicitePaie {
  MENSUEL
}

/// Cycle de vie du dossier de paie.
/// « Archive » n existe pas dans PaymaRH (voir etape 3 / E2 de la spec).
enum EtatDossier {
  /// Reprise d historique : aucun bulletin definitif.
  EN_MONTAGE
  /// Production normale des bulletins.
  EN_PRODUCTION
  /// Existe toujours, consultable et editable, mais plus de bulletins apres dateInactivite.
  INACTIVE
}

/// Les sept jours de la semaine (repos hebdomadaire, grille horaire).
enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

/// Etat d un compte bancaire societe.
enum EtatCompteBancaire {
  ACTIF
  CLOTURE
}

/// Nature d un jour ferie de reference (date fixe vs calendrier lunaire).
enum TypeJourFerie {
  CIVIL
  RELIGIEUX
}

// ---------------------------------------------------------------------------
// Modeles — socle multi-tenant
// ---------------------------------------------------------------------------

/// Le "tenant" : titulaire de l abonnement PaymaRH.
/// Premier niveau d isolation, aucune donnee ne franchit sa frontiere.
model Account {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  type      AccountType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  companies Company[]
  users     User[]
}

/// La societe dont on produira la paie.
/// Second niveau d isolation. Appartient TOUJOURS a un Account.
/// Le libelle legal est `raisonSociale` (le champ `name` du module 0 a ete retire en 1.1.b).
model Company {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Identification legale ---
  /// Reference interne unique dans le compte (cabinet).
  codeDossier               String
  raisonSociale             String
  nomCommercial             String?
  formeJuridiqueId          String             @db.Uuid
  activiteExercee           String?
  /// Identifiants legaux en String pour preserver les zeros de tete.
  identifiantFiscal         String?
  registreCommerce          String?
  tribunalRegistreCommerce  String?
  dateCreation              DateTime?          @db.Date
  dateCessationActivite     DateTime?          @db.Date
  siteWeb                   String?

  // --- Regime et cycle de vie ---
  regimeDeBase              RegimeDeBase       @default(NON_AGRICOLE)
  periodicitePaie           PeriodicitePaie    @default(MENSUEL)
  etatDossier               EtatDossier
  /// Mois au format AAAA-MM (texte, comparable / triable).
  moisDebutMontage          String
  moisDebutProduction       String
  /// Obligatoire si etatDossier = INACTIVE ; doit etre > moisDebutProduction.
  dateInactivite            String?
  /// Mois de paie en cours du dossier (AAAA-MM). Sert d horodatage des
  /// ecritures d historique. Initialise a moisDebutMontage. Avance par le
  /// module 2 uniquement — aucun endpoint de modification ici.
  moisEnCours               String

  // --- Employeur signataire ---
  signataireCivilite        String?
  signatairePrenom          String?
  signataireNom             String?
  signataireQualite         String?

  // --- Parametrage technique matricules / entrees-sorties ---
  matriculePrefixe                      String?
  matriculeLongueur                     Int      @default(5)
  matriculeGenerationAuto               Boolean  @default(true)
  calculAutoAbsencesEntreesSorties      Boolean  @default(true)

  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  formeJuridique FormeJuridique @relation(fields: [formeJuridiqueId], references: [id], onDelete: Restrict)

  etablissements             Etablissement[]
  parametragesHistoriques    CompanyParametrageHistorique[]
  comptesBancaires           CompteBancaire[]
  salaries                   Salarie[]
  compteursMatricule         CompteurMatricule[]

  @@unique([accountId, codeDossier])
  /// Unicite par compte si renseigne ; plusieurs NULL autorises (PostgreSQL).
  @@unique([accountId, identifiantFiscal])
  /// Cible de la FK composite Etablissement(companyId, accountId) :
  /// garantit que accountId denormalise reste aligne sur la societe.
  @@unique([id, accountId])
  @@index([accountId])
  @@index([formeJuridiqueId])
}

/// Un utilisateur du logiciel.
model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique

  /// NULLABLE par conception : un PLATFORM_ADMIN n appartient a aucun compte
  /// client. Pour tous les autres roles, ce champ est renseigne.
  accountId String? @db.Uuid

  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  auditLogs AuditLog[]

  @@index([accountId])
}

/// Journal d audit.
model AuditLog {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// Verbe de l action, en majuscules (ex. "READ_ACROSS_ACCOUNTS").
  action String

  /// Type de la ressource visee (ex. "Company").
  targetType String

  /// Identifiant de la ressource visee, nul si l action est globale.
  targetId String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Tables de reference nationales (pas d accountId)
// Maintenues par PLATFORM_ADMIN, lisibles par tous les comptes.
// ---------------------------------------------------------------------------

/// Forme juridique marocaine (SARL, SA, etc.).
model FormeJuridique {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  libelle String

  companies Company[]
}

/// Banque marocaine proposee a la saisie des RIB.
/// `codeBanque` (3 premiers chiffres du RIB) est prevu mais laisse vide pour l instant.
model Banque {
  id         String  @id @default(uuid()) @db.Uuid
  nom        String
  /// Ancien sigle conserve pour la recherche (ex. SGMB, BMCE).
  ancienNom  String?
  /// Trois premiers chiffres du RIB — a renseigner plus tard.
  codeBanque String?
  /// Couleur d affichage (hex, ex. #E2001A).
  couleur    String

  comptesBancaires        CompteBancaire[]
  comptesBancairesSalaries CompteBancaireSalarie[]
}

/// Jour ferie national. Le `code` est stable a vie ; le libelle peut evoluer.
/// Aucune date calendaire ici : la resolution (surtout lunaire) est le module 4.
model JourFerie {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique
  libelle       String
  /// Reference textuelle (ex. "1er janvier", "1er Chawal") — pas une date.
  referenceDate String
  type          TypeJourFerie

  etablissementsTravailles     JourFerieTravaille[]
  emploisJoursFeriesTravailles EmploiJourFerieTravaille[]
}

/// Type d heure de la grille (normale / majoree). Les taux reels viennent au module 5.
model TypeHeure {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  libelle String
  ordre   Int

  horaireDefautLignes  HoraireDefautLigne[]
  horaireMensuelLignes HoraireMensuelLigne[]
}

/// Type d exoneration societale (une seule a la fois, jamais de cumul).
model TypeExoneration {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  libelle String

  parametrages CompanyParametrageHistorique[]
}

// ---------------------------------------------------------------------------
// Etablissement
// ---------------------------------------------------------------------------

/// Lieu d exploitation d une societe.
/// `accountId` est denormalise pour l unicite de l ICE par compte et le
/// filtrage multi-tenant sans jointure. La FK composite vers
/// Company(id, accountId) rend toute divergence impossible en base.
model Etablissement {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  /// Denormalise depuis Company.accountId (isolation + unicite ICE).
  accountId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom                 String
  /// Exactement un true par societe (index unique partiel en migration SQL).
  estPrincipal        Boolean @default(false)
  adresse             String
  complementAdresse   String?
  codePostal          String?
  ville               String
  pays                String  @default("MA")
  /// ICE en String ; unique par accountId si renseigne (tous etablissements confondus).
  ice                 String?
  taxeProfessionnelle String?
  telephone           String?
  email               String?

  company                 Company                          @relation(fields: [companyId, accountId], references: [id, accountId], onDelete: Cascade)
  parametragesHistoriques EtablissementParametrageHistorique[]
  comptesBancaires        CompteBancaireEtablissement[]
  emploiAffectations      EmploiAffectationVersion[]

  @@unique([accountId, ice])
  @@index([companyId])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Historisation par moisEffet (AAAA-MM)
// Une ligne vaut a partir de son moisEffet jusqu au moisEffet de la suivante.
// L utilisateur ne saisit jamais cette date (deduite en 1.1.b).
// ---------------------------------------------------------------------------

/// Parametres societaux historises (conges, exoneration).
model CompanyParametrageHistorique {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  /// Mois a partir duquel cette ligne s applique (AAAA-MM). Cle avec companyId.
  moisEffet String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Mois de cloture des conges payes (1 = janvier … 12 = decembre). Defaut 12.
  moisClotureConges Int @default(12)

  typeExonerationId    String? @db.Uuid
  /// Obligatoire si une exoneration est choisie (controle applicatif en 1.1.b).
  exonerationDateDebut String?
  exonerationDateFin   String?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  typeExoneration TypeExoneration? @relation(fields: [typeExonerationId], references: [id], onDelete: Restrict)

  @@unique([companyId, moisEffet])
  @@index([companyId])
  @@index([typeExonerationId])
}

/// Parametres etablissement historises (duree, repos, teletravail, horaires, feries).
model EtablissementParametrageHistorique {
  id              String   @id @default(uuid()) @db.Uuid
  etablissementId String   @db.Uuid
  moisEffet       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dureeHebdomadaire             Decimal     @default(44) @db.Decimal(8, 2)
  jourReposHebdomadaire         JourSemaine @default(DIMANCHE)
  /// Trois etats : true / false / null (non renseigne).
  teletravailAutorise           Boolean?
  indemniteTeletravailVersee    Boolean?
  montantIndemniteTeletravail   Decimal?    @db.Decimal(14, 2)

  etablissement        Etablissement         @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  horaireDefautLignes  HoraireDefautLigne[]
  horaireMensuelLignes HoraireMensuelLigne[]
  joursFeriesTravailles JourFerieTravaille[]

  @@unique([etablissementId, moisEffet])
  @@index([etablissementId])
}

/// Une cellule de la grille horaire hebdomadaire (jour × type d heure).
model HoraireDefautLigne {
  id                                   String      @id @default(uuid()) @db.Uuid
  etablissementParametrageHistoriqueId String      @db.Uuid
  jourSemaine                          JourSemaine
  typeHeureId                          String      @db.Uuid
  nombreHeures                         Decimal     @db.Decimal(8, 2)

  parametrage EtablissementParametrageHistorique @relation(fields: [etablissementParametrageHistoriqueId], references: [id], onDelete: Cascade)
  typeHeure   TypeHeure                          @relation(fields: [typeHeureId], references: [id], onDelete: Restrict)

  @@unique([etablissementParametrageHistoriqueId, jourSemaine, typeHeureId])
  @@index([typeHeureId])
}

/// Heures mensuelles par type (saisies ou deduites de l hebdomadaire × 52/12).
model HoraireMensuelLigne {
  id                                   String  @id @default(uuid()) @db.Uuid
  etablissementParametrageHistoriqueId String  @db.Uuid
  typeHeureId                          String  @db.Uuid
  nombreHeures                         Decimal @db.Decimal(8, 2)

  parametrage EtablissementParametrageHistorique @relation(fields: [etablissementParametrageHistoriqueId], references: [id], onDelete: Cascade)
  typeHeure   TypeHeure                          @relation(fields: [typeHeureId], references: [id], onDelete: Restrict)

  @@unique([etablissementParametrageHistoriqueId, typeHeureId])
  @@index([typeHeureId])
}

/// Jour ferie marque comme travaille pour un parametrage etablissement donne.
model JourFerieTravaille {
  etablissementParametrageHistoriqueId String @db.Uuid
  jourFerieId                          String @db.Uuid

  parametrage EtablissementParametrageHistorique @relation(fields: [etablissementParametrageHistoriqueId], references: [id], onDelete: Cascade)
  jourFerie   JourFerie                          @relation(fields: [jourFerieId], references: [id], onDelete: Restrict)

  @@id([etablissementParametrageHistoriqueId, jourFerieId])
  @@index([jourFerieId])
}

// ---------------------------------------------------------------------------
// Comptes bancaires
// ---------------------------------------------------------------------------

/// Compte bancaire de la societe (RIB / IBAN).
/// Longueurs RIB/IBAN/BIC : avertissement API seulement, jamais contrainte DB.
model CompteBancaire {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  libelle              String?
  banqueId             String?              @db.Uuid
  /// Saisie libre si la banque n est pas dans le referentiel.
  banqueSaisieLibre    String?
  rib                  String?
  iban                 String?
  bic                  String?
  nomPayeur            String?
  usageSalaires              Boolean @default(false)
  usageCotisationsSociales   Boolean @default(false)
  usageIR                    Boolean @default(false)
  etat                 EtatCompteBancaire   @default(ACTIF)

  company        Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  banque         Banque?                       @relation(fields: [banqueId], references: [id], onDelete: Restrict)
  etablissements CompteBancaireEtablissement[]

  @@index([companyId])
  @@index([banqueId])
}

/// Liaison « utilise par » entre un compte bancaire et un ou plusieurs etablissements.
model CompteBancaireEtablissement {
  compteBancaireId String @db.Uuid
  etablissementId  String @db.Uuid

  compteBancaire CompteBancaire @relation(fields: [compteBancaireId], references: [id], onDelete: Cascade)
  etablissement  Etablissement  @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@id([compteBancaireId, etablissementId])
  @@index([etablissementId])
}

// ---------------------------------------------------------------------------
// Enumerations — fiche salarie (module 2, etape 2.1.a)
// ---------------------------------------------------------------------------

enum Sexe {
  HOMME
  FEMME
}

enum StatutCadre {
  CADRE
  NON_CADRE
}

enum ModeDeterminationSalaire {
  BRUT_MENSUEL
  BRUT_HORAIRE
  NET_CIBLE
}

enum ModePaiement {
  VIREMENT
  CHEQUE
  ESPECES
}

enum BaseSaisieDuree {
  HEBDOMADAIRE
  MENSUELLE
}

enum OrigineStatut {
  SAISIE_MANUELLE
  PROPAGE_SOCIETE
}

/// Les cinq blocs historises de la fiche salarie.
enum BlocHistorise {
  CONTRAT
  REMUNERATION
  AFFECTATION_TEMPS_DE_TRAVAIL
  PERSONNES_A_CHARGE
  RETENUES
}

// ---------------------------------------------------------------------------
// Tables de reference — fiche salarie
// ---------------------------------------------------------------------------

/// Pays souverains (195 entrees). Ordre d affichage fixe (Maroc en tete).
model Pays {
  id      String @id @default(uuid()) @db.Uuid
  ordre   Int    @unique
  codeIso String @unique
  libelle String

  salariesNaissance   Salarie[] @relation("Naissance")
  salariesNationalite Salarie[] @relation("Nationalite")
  salariesResidence   Salarie[] @relation("Residence")
}

/// Type de contrat de travail (liste ouverte).
model TypeContrat {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  libelle String

  contrats EmploiContratVersion[]
}

/// Motif de sortie du salarie.
model MotifSortie {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  libelle String

  contrats EmploiContratVersion[]
}

/// Statut particulier (liste ouverte). TAHFIZ n y figure pas (propagation societe).
model StatutParticulier {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  libelle String

  lignes StatutParticulierLigne[]
}

/// Situation familiale — le code est stocke ; libelles accordes au genre a l affichage.
model SituationFamiliale {
  id              String @id @default(uuid()) @db.Uuid
  code            String @unique
  libelleMasculin String
  libelleFeminin  String

  salaries Salarie[]
}

/// Lien de parente pour les personnes a charge.
model LienParente {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  libelle String

  personnes PersonneACharge[]
}

/// Compteur de matricules auto-generes par societe et par prefixe. Jamais decremente.
model CompteurMatricule {
  companyId     String @db.Uuid
  /// Prefixe de numerotation ; chaine vide autorisee.
  prefixe       String @default("")
  dernierNumero Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, prefixe])
}

/// Compteur de numero d ordre d emploi par salarie. Jamais decremente.
model CompteurNumeroOrdreEmploi {
  salarieId     String @id @db.Uuid
  dernierNumero Int

  salarie Salarie @relation(fields: [salarieId], references: [id], onDelete: Restrict)
}

// ---------------------------------------------------------------------------
// Fiche salarie
// ---------------------------------------------------------------------------

/// Identite d un salarie dans une societe (1 par personne par societe).
model Salarie {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matricule String
  nom       String
  prenom    String
  sexe      Sexe
  dateNaissance DateTime @db.Date

  villeNaissance         String?
  paysNaissanceId        String? @db.Uuid
  nationaliteId          String? @db.Uuid
  situationFamilialeCode String?

  /// Identifiants legaux en texte (zeros de tete preserves).
  numeroPiece String?
  numeroCnss  String?
  numeroCimr  String?

  adresse                String?
  complementAdresse      String?
  ville                  String?
  codePostal             String?
  paysId                 String? @db.Uuid
  telephonePersonnel     String?
  telephoneProfessionnel String?
  emailPersonnel         String?
  emailProfessionnel     String?

  urgencePrenom    String?
  urgenceNom       String?
  urgenceTelephone String?
  urgenceEmail     String?

  dateEntree     DateTime @db.Date
  dateAnciennete DateTime @db.Date

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paysNaissance      Pays?               @relation("Naissance", fields: [paysNaissanceId], references: [id], onDelete: Restrict)
  nationalite        Pays?               @relation("Nationalite", fields: [nationaliteId], references: [id], onDelete: Restrict)
  pays               Pays?               @relation("Residence", fields: [paysId], references: [id], onDelete: Restrict)
  situationFamiliale SituationFamiliale? @relation(fields: [situationFamilialeCode], references: [code], onDelete: Restrict)

  personnesACharge  PersonneACharge[]
  comptesBancaires  CompteBancaireSalarie[]
  prets             Pret[]
  saisiesSurSalaire SaisieSurSalaire[]
  emplois           Emploi[]
  compteurNumeroOrdre CompteurNumeroOrdreEmploi?

  @@unique([companyId, matricule])
  @@index([companyId])
  @@index([paysNaissanceId])
  @@index([nationaliteId])
  @@index([paysId])
  @@index([situationFamilialeCode])
}

/// Emploi d un salarie dans la societe. Un salarie peut en porter plusieurs.
model Emploi {
  id          String   @id @default(uuid()) @db.Uuid
  salarieId   String   @db.Uuid
  /// Ordre technique de calcul ; jamais reutilise apres suppression.
  numeroOrdre Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salarie Salarie @relation(fields: [salarieId], references: [id], onDelete: Cascade)

  contratVersions      EmploiContratVersion[]
  remunerationVersions EmploiRemunerationVersion[]
  affectationVersions  EmploiAffectationVersion[]
  primesContractuelles PrimeContractuelle[]
  avantagesEnNature    AvantageEnNature[]
  statutsParticuliers  StatutParticulierLigne[]
  joursFeriesTravailles EmploiJourFerieTravaille[]

  @@unique([salarieId, numeroOrdre])
  @@index([salarieId])
}

/// Bloc CONTRAT — version historisee par moisEffet.
model EmploiContratVersion {
  id        String   @id @default(uuid()) @db.Uuid
  emploiId  String   @db.Uuid
  moisEffet String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  libellePoste            String
  dateDebut               DateTime    @db.Date
  dateFin                 DateTime?   @db.Date
  typeContratCode         String
  periodeEssaiDateFin     DateTime?   @db.Date
  renouvellementEssaiDateFin DateTime? @db.Date
  statutCadre             StatutCadre?
  coefficient             String?
  position                String?
  indice                  String?
  dateSortie              DateTime?   @db.Date
  motifSortieCode         String?

  emploi        Emploi        @relation(fields: [emploiId], references: [id], onDelete: Cascade)
  typeContrat   TypeContrat   @relation(fields: [typeContratCode], references: [code], onDelete: Restrict)
  motifSortie   MotifSortie?  @relation(fields: [motifSortieCode], references: [code], onDelete: Restrict)

  @@unique([emploiId, moisEffet])
  @@index([emploiId])
  @@index([typeContratCode])
  @@index([motifSortieCode])
}

/// Bloc REMUNERATION — version historisee par moisEffet.
model EmploiRemunerationVersion {
  id        String   @id @default(uuid()) @db.Uuid
  emploiId  String   @db.Uuid
  moisEffet String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modeDeterminationSalaire ModeDeterminationSalaire
  montant                  Decimal @db.Decimal(14, 2)
  masquerNombreHeures      Boolean @default(false)
  masquerTauxHoraire       Boolean @default(false)
  bulletinTousLesMois      Boolean @default(true)
  moisProduction           Int[]
  modePaiement             ModePaiement?
  compteBancaireId         String? @db.Uuid
  /// Nullable = herite de l etablissement / societe.
  teletravailIndemniteVersee Boolean?
  /// Nullable = herite de l etablissement / societe.
  teletravailMontant         Decimal? @db.Decimal(14, 2)

  emploi           Emploi                @relation(fields: [emploiId], references: [id], onDelete: Cascade)
  compteBancaire   CompteBancaireSalarie? @relation(fields: [compteBancaireId], references: [id], onDelete: Restrict)

  @@unique([emploiId, moisEffet])
  @@index([emploiId])
  @@index([compteBancaireId])
}

/// Bloc AFFECTATION_TEMPS_DE_TRAVAIL — version historisee par moisEffet.
model EmploiAffectationVersion {
  id        String   @id @default(uuid()) @db.Uuid
  emploiId  String   @db.Uuid
  moisEffet String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etablissementId String @db.Uuid
  departementRef  String?
  serviceRef      String?
  baseSaisieDuree BaseSaisieDuree
  /// Nullable = herite etablissement puis national.
  dureeContractuelle Decimal? @db.Decimal(8, 2)
  /// Nullable = herite etablissement (grille horaire module 3).
  repartitionHoraireRef String?
  /// Nullable = herite etablissement.
  reposHebdomadaire JourSemaine?
  /// Non nullable : true = suivre les jours feries de l etablissement.
  suivreJoursFeriesEtablissement Boolean @default(true)
  /// Nullable = herite etablissement.
  teletravailAutorise Boolean?

  emploi          Emploi        @relation(fields: [emploiId], references: [id], onDelete: Cascade)
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Restrict)

  @@unique([emploiId, moisEffet])
  @@index([emploiId])
  @@index([etablissementId])
}

/// Personne a charge — bloc PERSONNES_A_CHARGE (validite temporelle par ligne).
model PersonneACharge {
  id        String   @id @default(uuid()) @db.Uuid
  salarieId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lienParenteCode String
  prenom          String
  nom             String
  sexe            Sexe
  dateNaissance   DateTime @db.Date
  aCharge         Boolean
  /// Seule donnee de sante de la fiche ; pertinent uniquement si lienParenteCode = ENFANT.
  situationHandicap Boolean @default(false)
  moisEffetDebut  String
  moisEffetFin    String?

  salarie     Salarie     @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  lienParente LienParente @relation(fields: [lienParenteCode], references: [code], onDelete: Restrict)

  @@index([salarieId])
  @@index([lienParenteCode])
}

/// Compte bancaire du salarie (RIB / IBAN). Modele distinct du CompteBancaire societe.
model CompteBancaireSalarie {
  id        String   @id @default(uuid()) @db.Uuid
  salarieId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  banqueId           String? @db.Uuid
  banqueLibreSaisie  String?
  rib                String?
  iban               String?
  bic                String?
  titulaire          String?
  partVirement       Decimal? @db.Decimal(5, 2)

  salarie            Salarie                     @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  banque             Banque?                     @relation(fields: [banqueId], references: [id], onDelete: Restrict)
  remunerations      EmploiRemunerationVersion[]

  @@index([salarieId])
  @@index([banqueId])
}

/// Pret — bloc RETENUES (validite temporelle par ligne).
model Pret {
  id        String   @id @default(uuid()) @db.Uuid
  salarieId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  libelleObjet      String
  libelleBulletin   String
  montantTotal      Decimal @db.Decimal(14, 2)
  moisDebut         String
  mensualite        Decimal @db.Decimal(14, 2)
  nombreEcheances   Int
  moisEffetDebut    String
  moisEffetFin      String?

  salarie Salarie @relation(fields: [salarieId], references: [id], onDelete: Cascade)

  @@index([salarieId])
}

/// Saisie sur salaire — bloc RETENUES (validite temporelle par ligne).
model SaisieSurSalaire {
  id        String   @id @default(uuid()) @db.Uuid
  salarieId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referenceDecision String
  creancier         String
  libelleBulletin   String
  montantTotal      Decimal @db.Decimal(14, 2)
  montantMensuel    Decimal @db.Decimal(14, 2)
  moisDebut         String
  moisEffetDebut    String
  moisEffetFin      String?

  salarie Salarie @relation(fields: [salarieId], references: [id], onDelete: Cascade)

  @@index([salarieId])
}

/// Prime contractuelle — non historisee (transit par elements variables).
model PrimeContractuelle {
  id             String @id @default(uuid()) @db.Uuid
  emploiId       String @db.Uuid
  primeRef       String
  moisApplication Int[]

  emploi Emploi @relation(fields: [emploiId], references: [id], onDelete: Cascade)

  @@index([emploiId])
}

/// Avantage en nature — historise par validite temporelle (bloc REMUNERATION).
model AvantageEnNature {
  id              String   @id @default(uuid()) @db.Uuid
  emploiId        String   @db.Uuid
  natureRef       String
  montant         Decimal  @db.Decimal(14, 2)
  moisApplication Int[]
  moisEffetDebut  String
  moisEffetFin    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  emploi Emploi @relation(fields: [emploiId], references: [id], onDelete: Cascade)

  @@index([emploiId])
}

/// Ligne de statut particulier sur un emploi.
model StatutParticulierLigne {
  id          String   @id @default(uuid()) @db.Uuid
  emploiId    String   @db.Uuid
  statutCode  String
  dateDebut   DateTime @db.Date
  dateFin     DateTime? @db.Date
  origine     OrigineStatut @default(SAISIE_MANUELLE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  emploi  Emploi            @relation(fields: [emploiId], references: [id], onDelete: Cascade)
  statut  StatutParticulier @relation(fields: [statutCode], references: [code], onDelete: Restrict)

  @@index([emploiId])
  @@index([statutCode])
}

/// Jour ferie travaille pour un emploi — historise par validite temporelle.
model EmploiJourFerieTravaille {
  emploiId       String @db.Uuid
  jourFerieId    String @db.Uuid
  moisEffetDebut String
  moisEffetFin   String?

  emploi    Emploi    @relation(fields: [emploiId], references: [id], onDelete: Cascade)
  jourFerie JourFerie @relation(fields: [jourFerieId], references: [id], onDelete: Restrict)

  @@id([emploiId, jourFerieId, moisEffetDebut])
  @@index([jourFerieId])
}
